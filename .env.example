# ── Supabase (server-side — NUNCA expor ao cliente) ──────────────────────────
# Obtém em: supabase.com → Project Settings → API → service_role key
# ATENÇÃO: Esta chave bypassa todas as RLS policies. Usar apenas server-side.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe (server-side) ──────────────────────────────────────────────────────
# Obtém em: dashboard.stripe.com → Developers → API Keys → Secret key
STRIPE_SECRET_KEY=sk_live_...
# Obtém em: dashboard.stripe.com → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Servidor Express ─────────────────────────────────────────────────────────
PING_MESSAGE=ping
# Origens CORS permitidas (separadas por vírgula; fallback: https://suckorsex.com)
ALLOWED_ORIGINS=https://suckorsex.com
