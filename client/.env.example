# ── Supabase (público — anon key é segura no cliente) ────────────────────────
# Obtém em: supabase.com → Project Settings → API → anon/public key
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...

# ── Stripe (público — publishable key é segura no cliente) ───────────────────
# Obtém em: dashboard.stripe.com → Developers → API Keys → Publishable key
VITE_STRIPE_PUBLIC_KEY=pk_live_...

# ── Stripe Price IDs (apenas referência local — não são segredos) ─────────────
STRIPE_PRICE_NORMAL_MONTHLY=price_...
STRIPE_PRICE_NORMAL_YEARLY=price_...
STRIPE_PRICE_EXCLUSIVO_MONTHLY=price_...
STRIPE_PRICE_EXCLUSIVO_YEARLY=price_...
STRIPE_PRICE_RARO_MONTHLY=price_...
STRIPE_PRICE_RARO_YEARLY=price_...
